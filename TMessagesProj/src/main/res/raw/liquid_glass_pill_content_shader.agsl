uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float radius;
uniform float thickness;
uniform float glass_press;
uniform float glass_motion;

float sdfPill(float2 p, float2 halfSize, float r) {
  float rad = min(r, min(halfSize.x, halfSize.y));
  float2 q = abs(p) - halfSize + rad;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
}

float gaussian(float x) {
  return exp(-x * x);
}

float circleMap(float x) {
  return 1.0 - sqrt(max(0.0, 1.0 - x * x));
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = sdfPill(p, size, radius);
  if (sdRaw > 0.75) {
    return half4(0.0);
  }
  float pillAA = smoothstep(0.75, -0.75, sdRaw);
  float sd = min(sdRaw, 0.0);
  float gx = sdfPill(p + float2(1.0, 0.0), size, radius) - sdRaw;
  float gy = sdfPill(p + float2(0.0, 1.0), size, radius) - sdRaw;
  float gLen = length(float2(gx, gy));
  float2 edgeDir = gLen > 0.001 ? float2(gx, gy) / gLen : float2(0.0, -1.0);

  float minHalf = max(min(size.x, size.y), 4.0);
  float uDp = max(minHalf / 24.0, 1.0);
  float dDp = -sd / uDp;
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 1.15), 0.0, 1.0);

  // Single-sign Apple circleMap meniscus shifted ~1.65dp inward from both edges.
  // Avoids opposing UV sign flips (zero letter pinching) while keeping the meniscus reflection inset from dDp=0.
  float lensH = clamp((7.2 + 2.8 * lift) * uDp, 5.5, minHalf * 0.62);
  float lensDepth = clamp(-sd / minHalf, 0.0, 1.0);
  float rimT = clamp(1.0 + (sd + 1.65 * uDp) / lensH, 0.0, 1.0);
  float slope = circleMap(rimT);
  float rawBevel = mix(slope, rimT * rimT, 0.36);
  float insetFade = smoothstep(0.25, 1.85, dDp);
  float bevel = rawBevel * (0.42 + 0.58 * insetFade);

  float2 invSize = 1.0 / max(size, float2(1.0));
  float2 relCenter = clamp(p * invSize, float2(-1.0), float2(1.0));
  float rightSide = smoothstep(-0.05, 0.90, relCenter.x);
  float rightWave = sin(relCenter.y * 2.6 - move * 2.2) * rightSide * bevel * uDp * (0.32 + 0.75 * lift);

  float2 anisoEdge = float2(edgeDir.x, edgeDir.y * 0.18);
  float magFactor = (0.022 + lift * 0.095) * (0.35 + 0.65 * lensDepth);
  float2 refractOffset = -p * magFactor
      - anisoEdge * bevel * uDp * (1.60 + lift * 3.85)
      + float2(0.0, rightWave * 0.24);

  float2 uv = fragCoord + refractOffset;
  float prismBell = bevel * insetFade;
  float2 disp = -anisoEdge * (0.68 + lift * 1.75) * uDp * prismBell;

  half4 gC = img.eval(uv);
  half4 rC = img.eval(uv + disp);
  half4 bC = img.eval(uv - disp);

  float fringe = clamp((0.40 + 0.52 * lift) * prismBell, 0.0, 0.90);
  half r = mix(gC.r, rC.r, half(fringe));
  half b = mix(gC.b, bC.b, half(fringe));
  half rA = mix(gC.a, rC.a, half(fringe));
  half bA = mix(gC.a, bC.a, half(fringe));
  half contentA = max(gC.a, max(rA, bA));
  half4 refracted = half4(min(half3(contentA), half3(r, gC.g, b)), contentA) * half(pillAA);

  // Subtle prismatic opposite-rim meniscus reflection (~2.65dp inset from both ends).
  float reflectInsetBand = gaussian((dDp - 2.65) / 0.88)
      * pow(abs(edgeDir.x), 1.75)
      * smoothstep(0.70, 0.92, abs(relCenter.x))
      * insetFade;
  float oppDepthPx = (1.6 + clamp(dDp - 1.6, 0.0, 3.2) * 2.6) * uDp;
  float oppX = -sign(p.x) * max(0.0, size.x - oppDepthPx);
  float2 mirrorUV = center + float2(oppX, p.y * (0.78 + 0.12 * bevel));
  float2 mirrorDisp = anisoEdge * uDp * (1.25 + 1.95 * lift);
  half4 mG = img.eval(mirrorUV);
  half4 mRC = img.eval(mirrorUV + mirrorDisp);
  half4 mBC = img.eval(mirrorUV - mirrorDisp);
  half mA = max(mG.a, max(mRC.a, mBC.a));
  half3 prismMirrorRGB = half3(mRC.r, mG.g * half(0.96), mBC.b);
  half4 mirrorCol = half4(min(half3(mA), prismMirrorRGB), mA);
  float reflectMask = reflectInsetBand * (0.13 + 0.15 * lift) * (1.0 - float(refracted.a)) * pillAA;
  half4 reflectedObj = mirrorCol * half(reflectMask);

  float combinedA = clamp(float(refracted.a) + float(reflectedObj.a) * (1.0 - float(refracted.a)), 0.0, 1.0);
  half3 combinedRGB = min(half3(combinedA), refracted.rgb + reflectedObj.rgb * half(1.0 - float(refracted.a)));
  half4 glassContent = half4(combinedRGB, half(combinedA));

  // Crisp outer specular glint + right-side liquid tide ("прилив справа").
  float angle = -2.356 + move * 0.58;
  float2 lightDir = float2(cos(angle), sin(angle));
  float rawDot = dot(edgeDir, lightDir);
  float keyArc = pow(max(rawDot, 0.0), 2.8);
  float catchArc = pow(max(-rawDot, 0.0), 2.6);
  float rightFlowArc = smoothstep(-0.05, 0.85, edgeDir.x)
      * smoothstep(-0.75, 0.92, edgeDir.y + move * 0.42);
  float capMask = rightFlowArc * (0.36 + 0.32 * lift) + pow(abs(edgeDir.x), 2.6) * (0.12 + 0.18 * lift);

  float edgeGlow = gaussian((dDp - 1.25) / 1.15);
  float darkRim = gaussian((dDp - 2.30) / 1.25) * (0.03 + 0.04 * lift);
  float innerMeniscus = gaussian((dDp - 3.15) / 1.85);
  float rightTideBand = gaussian((dDp - (2.30 + 1.00 * lift)) / (1.70 + 0.55 * lift));

  float rimGlint = (keyArc * 0.42 + catchArc * 0.40 + capMask)
          * (edgeGlow * 0.72 + innerMeniscus * 0.28) * (0.12 + 0.22 * lift)
      + rightFlowArc * rightTideBand * (0.10 + 0.18 * lift);

  float sweepCoord = relCenter.x * 0.80 + relCenter.y * 0.42 - move * 0.42;
  float oppSweepCoord = -relCenter.x * 0.80 - relCenter.y * 0.42 - move * 0.34;
  float sweep = (gaussian((sweepCoord - 0.52) / 0.24) + gaussian((oppSweepCoord - 0.52) / 0.24) * 0.86)
      * (0.10 * abs(move) + 0.06 * press) * bevel;

  float specAlpha = clamp(rimGlint + sweep, 0.0, 0.32) * pillAA;
  half3 specRGB = mix(half3(0.74, 0.90, 1.0), half3(1.0, 0.96, 0.88),
      half(clamp(rawDot * 0.5 + 0.5, 0.0, 1.0))) * half(specAlpha);

  half3 shadowed = glassContent.rgb * half(1.0 - darkRim * float(glassContent.a));
  half3 outRGB = specRGB + shadowed * half(1.0 - specAlpha);
  float outAlpha = specAlpha + float(glassContent.a) * (1.0 - specAlpha);
  return half4(min(outRGB, half3(outAlpha)), half(outAlpha));
}
