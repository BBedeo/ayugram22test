uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float radius;
uniform float thickness;
uniform float glass_press;
uniform float glass_motion;

float sdfPill(float2 p, float2 halfSize, float r) {
  float rad = min(r, min(halfSize.x, halfSize.y));
  float2 q = abs(p) - halfSize + rad;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
}

float gaussian(float x) {
  return exp(-x * x);
}

float circleMap(float x) {
  return 1.0 - sqrt(max(0.0, 1.0 - x * x));
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = sdfPill(p, size, radius);
  if (sdRaw > 0.75) {
    return half4(0.0);
  }
  float pillAA = smoothstep(0.75, -0.75, sdRaw);
  float sd = min(sdRaw, 0.0);
  float gx = sdfPill(p + float2(1.0, 0.0), size, radius) - sdRaw;
  float gy = sdfPill(p + float2(0.0, 1.0), size, radius) - sdRaw;
  float gLen = length(float2(gx, gy));
  float2 edgeDir = gLen > 0.001 ? float2(gx, gy) / gLen : float2(0.0, -1.0);

  float minHalf = max(min(size.x, size.y), 4.0);
  float uDp = max(minHalf / 24.0, 1.0);
  float dDp = -sd / uDp;
  float t = clamp(thickness, 4.0, minHalf * 0.90);
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 1.15), 0.0, 1.0);

  // DP-normalized WWDC25 magnifying loupe + wide circular meniscus shoulder across icons & words.
  float lensH = clamp(max(t, minHalf * 0.90), 6.0, minHalf * 0.96);
  float lensDepth = clamp(-sd / minHalf, 0.0, 1.0);
  float rimT = clamp(1.0 + sd / lensH, 0.0, 1.0);
  float slope = circleMap(rimT);
  float bevel = mix(pow(max(rimT, 0.0001), 1.32), slope, 0.52);

  float magFactor = (0.055 + lift * 0.225) * (0.35 + 0.65 * lensDepth);
  float2 capCompress = float2(-p.x * (0.06 + 0.16 * lift), p.y * (0.04 + 0.12 * lift))
      * abs(edgeDir.x) * bevel;
  float2 refractOffset = -p * magFactor
      - edgeDir * bevel * minHalf * (0.24 + lift * 0.60)
      + capCompress
      + float2(move * minHalf * 0.28, 0.0) * bevel;

  float2 uv = fragCoord + refractOffset;
  float2 disp = (-edgeDir * (1.35 + lift * 3.85) * uDp + float2(move * 1.65 * uDp, 0.0)) * bevel;

  half4 gC = img.eval(uv);
  half4 rC = img.eval(uv + disp);
  half4 bC = img.eval(uv - disp);

  float fringe = clamp((0.52 + 0.48 * lift) * bevel, 0.0, 1.0);
  half r = mix(gC.r, rC.r, half(fringe));
  half b = mix(gC.b, bC.b, half(fringe));
  half rA = mix(gC.a, rC.a, half(fringe));
  half bA = mix(gC.a, bC.a, half(fringe));
  half contentA = max(gC.a, max(rA, bA));
  half4 refracted = half4(min(half3(contentA), half3(r, gC.g, b)), contentA) * half(pillAA);

  // DP-scaled 3-band WWDC optical meniscus wall (outer Fresnel crest -> dark TIR trough -> inner caustic ridge)
  // keeping the center (dDp > 10.5) crystal-clear with zero milky plastic wash.
  float2 invSize = 1.0 / max(size, float2(1.0));
  float2 relCenter = clamp(p * invSize, float2(-1.0), float2(1.0));
  float angle = -2.356 + move * 0.44;
  float2 lightDir = float2(cos(angle), sin(angle));
  float rawDot = dot(edgeDir, lightDir);
  float keyArc = pow(max(rawDot * 0.65 + 0.35, 0.0001), 3.6);
  float catchArc = pow(max(-rawDot * 0.65 + 0.35, 0.0001), 4.0) * 0.68;
  float capMask = pow(max(abs(edgeDir.x) * 0.80 + 0.20, 0.0001), 1.65) * (0.52 + 0.24 * lift);

  float edgeGlow = gaussian((dDp - 1.15) / 1.05);
  float darkRim = gaussian((dDp - 3.35) / 1.80) * (0.32 + 0.14 * lift);
  float innerMeniscus = gaussian((dDp - 6.40) / 2.45) * (0.26 + 0.22 * lift);
  float lowerCaustic = smoothstep(0.18, 0.95, relCenter.y) * innerMeniscus * (0.55 + 0.45 * lift);

  float rimGlint = (keyArc * 0.72 + catchArc * 0.48 + capMask + (0.06 + 0.10 * lift))
          * edgeGlow * (0.78 + 0.36 * lift)
      + (keyArc * 0.42 + catchArc * 0.55 + capMask * 0.75 + 0.12) * innerMeniscus
      + lowerCaustic;

  float sweepCoord = relCenter.x * 0.78 + relCenter.y * 0.45 - move * 0.38;
  float sweep = gaussian(sweepCoord / 0.18)
      * (0.26 * abs(move) + 0.10 * press) * (0.20 + 0.80 * bevel);

  float specAlpha = clamp(rimGlint + sweep, 0.0, 0.88) * pillAA;
  half3 baseSpec = mix(half3(0.76, 0.92, 1.0), half3(1.0, 0.98, 0.92),
      half(clamp(rawDot * 0.5 + 0.5, 0.0, 1.0)));
  half3 prismShift = half3(0.14 * float(clamp(rawDot, -1.0, 1.0)), 0.0,
      -0.16 * float(clamp(rawDot, -1.0, 1.0))) * half(clamp(innerMeniscus * 2.2, 0.0, 1.0));
  half3 specRGB = clamp(baseSpec + prismShift, half3(0.0), half3(1.0)) * half(specAlpha);

  float tirAlpha = darkRim * 0.42 * pillAA;
  half3 shadowed = refracted.rgb * half(1.0 - darkRim * float(refracted.a));
  float combinedDarkA = tirAlpha + float(refracted.a) * (1.0 - tirAlpha);
  half3 darkBaseRGB = shadowed * half(1.0 - tirAlpha);

  half3 outRGB = specRGB + darkBaseRGB * half(1.0 - specAlpha);
  float outAlpha = specAlpha + combinedDarkA * (1.0 - specAlpha);
  return half4(min(outRGB, half3(outAlpha)), half(outAlpha));
}
