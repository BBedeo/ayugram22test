uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float radius;
uniform float thickness;
uniform float glass_press;
uniform float glass_motion;

float sdfPill(float2 p, float2 halfSize, float r) {
  float rad = min(r, min(halfSize.x, halfSize.y));
  float2 q = abs(p) - halfSize + rad;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - rad;
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = sdfPill(p, size, radius);
  if (sdRaw > 0.5) {
    return half4(0.0);
  }
  float sd = min(sdRaw, 0.0);
  float gx = sdfPill(p + float2(1.0, 0.0), size, radius) - sdRaw;
  float gy = sdfPill(p + float2(0.0, 1.0), size, radius) - sdRaw;
  float gLen = length(float2(gx, gy));
  float2 edgeDir = gLen > 0.001 ? float2(gx, gy) / gLen : float2(0.0, -1.0);

  float t = clamp(thickness, 4.0, min(size.x, size.y) * 0.90);
  float rimT = clamp(1.0 + sd / t, 0.0, 1.0);
  float bevel = pow(max(rimT, 0.0001), 1.40);
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 1.15), 0.0, 1.0);

  // Convex optical droplet magnification inside the pill + smooth bevel lip wrap without double-ghosting.
  float magFactor = (0.075 + lift * 0.105) * (1.0 - bevel * 0.48);
  float2 refractOffset = -p * magFactor
      + edgeDir * bevel * t * (0.26 + lift * 0.18)
      + float2(move * t * 0.20, 0.0) * bevel;

  float2 uv = fragCoord + refractOffset;
  float2 disp = edgeDir * (1.5 + lift * 2.1) * bevel;

  half4 centerSample = img.eval(uv);
  half rVal = img.eval(uv + disp).r;
  half bVal = img.eval(uv - disp).b;

  float fringe = 0.78 * bevel;
  half3 rgb = half3(
      mix(centerSample.r, rVal, half(fringe)),
      centerSample.g,
      mix(centerSample.b, bVal, half(fringe)));

  // Subtle top-rim specular kiss strictly inside opaque glyph pixels (premultiplied-safe).
  float topKiss = bevel * pow(max(dot(edgeDir, float2(-0.707, -0.707)) * 0.5 + 0.5, 0.0001), 2.5);
  rgb = min(half3(centerSample.a), rgb + half3(0.14 * topKiss) * centerSample.a);

  return half4(rgb, centerSample.a);
}
