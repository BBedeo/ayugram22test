uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float glass_press;
uniform float glass_highlight;
uniform float glass_light_angle;
uniform float glass_motion;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  half2 p = fragCoord - center;
  half sdRaw = sdfRect(p, radius);
  half2 uv = fragCoord;
  // past the edge the lens goes on as at the edge: the outline clips it, but a downsampled glass is upscaled over it
  half sd = min(sdRaw, 0.0);
  half sdX = sdfRect(p + half2(1.0, 0.0), radius);
  half sdY = sdfRect(p + half2(0.0, 1.0), radius);

  half n_cos = max(thickness + sd, 0.0) / thickness;
  half n_cos2 = n_cos * n_cos;
  half n_sin = sqrt(1.0 - n_cos2);
  half3 normal = normalize(half3((sdX - sdRaw) * n_cos, (sdY - sdRaw) * n_cos, n_sin));

  half3 refract_vec = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / refract_index);
  half h = sd < -thickness ? thickness : sqrt(sd * (-2.0 * thickness - sd));
  half refract_length = (h + 8.0 * thickness) / -refract_vec.z;

  // A subtle optical stretch is triggered only while the glass is pressed.
  // The rounded path and hit targets stay unchanged; only the image bends.
  float2 elastic = (p / max(size, float2(1.0))) * min(size.x, size.y) * glass_press * 0.038;
  uv += refract_vec.xy * refract_length * refract_intensity * (1.0 + glass_press * 0.36) + elastic;
  // on a small shape the edge samples past the far side: stay within the shape, whatever the grid of a downsampled node
  uv = clamp(uv, center - size + 0.5, center + size - 0.5);

  half4 surface = srcOver(half4(foreground_color_premultiplied), img.eval(uv));
  // Directional Fresnel glint; no continuous animation and no GPU readback.
  // A pressed view sweeps the virtual highlight and bends its optical surface.
  if (glass_highlight > 0.001) {
      half2 edgeNormal = normalize(half2(sdX - sdRaw, sdY - sdRaw) + half2(0.001, 0.001));
      float angle = glass_light_angle + glass_motion * 0.85;
      half2 sourceDir = half2(cos(angle), sin(angle));
      half facing = clamp(dot(edgeNormal, sourceDir) * 0.5 + 0.5, 0.0, 1.0);
      half edge = clamp((thickness + sd) / max(thickness, 0.001), 0.0, 1.0);
      half glint = facing * facing * facing * edge * glass_highlight * (0.13 + glass_press * 0.17);
      surface.rgb = min(half3(1.0), surface.rgb + half3(glint * surface.a));
  }
  return surface;
}