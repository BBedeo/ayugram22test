uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float glass_press;
uniform float glass_highlight;
uniform float glass_light_angle;
uniform float glass_motion;
uniform float glass_adaptive;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
  half3 outRGB = src.rgb + dst.rgb * (1.0 - src.a);
  float outA = src.a + (1.0 - src.a) * dst.a;
  return half4(outRGB, outA);
}

float gaussian(float x) {
  return exp(-x * x);
}

float circleMap(float x) {
  return 1.0 - sqrt(max(0.0, 1.0 - x * x));
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = float(sdfRect(half2(p), half4(radius)));
  float sd = min(sdRaw, 0.0);

  float2 gradRaw = float2(
      float(sdfRect(half2(p + float2(1.0, 0.0)), half4(radius))) - sdRaw,
      float(sdfRect(half2(p + float2(0.0, 1.0)), half4(radius))) - sdRaw);
  float gradLen = length(gradRaw);
  float2 edgeDir = gradLen > 0.001 ? gradRaw / gradLen : float2(0.0, -1.0);

  float minHalf = max(min(size.x, size.y), 4.0);
  float uDp = clamp(minHalf / 23.0, 1.0, 3.6);
  float dDp = -sd / uDp;
  float t = clamp(thickness, 2.0, minHalf * 0.92);
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 0.72), 0.0, 1.0);

  // Single-sign inset iOS 26 toric meniscus (~1.45dp inset, zero edge fold).
  float lensH = clamp((7.8 + 2.6 * lift) * uDp, 5.5, minHalf * 0.66);
  float rimT = clamp(1.0 + (sd + 1.45 * uDp) / lensH, 0.0, 1.0);
  float slope = circleMap(rimT);
  float insetFade = smoothstep(0.22, 1.65, dDp);
  float bevel = mix(slope, rimT * rimT, 0.35) * (0.50 + 0.50 * insetFade);
  float domeT = clamp(-sd / minHalf, 0.0, 1.0);

  float nCos = bevel * (0.56 + 0.30 * lift);
  float nSin = sqrt(max(0.05, 1.0 - nCos * nCos));
  float3 normal = normalize(float3(edgeDir * nCos, nSin));
  float3 ray = refract(float3(0.0, 0.0, -1.0), normal, 1.0 / max(refract_index, 1.05));

  float h = sd < -lensH ? lensH : sqrt(max(0.0, -sd * (2.0 * lensH + sd)));
  float rayDepth = (h + 8.5 * lensH) / max(-ray.z, 0.25);

  float2 invSize = 1.0 / max(size, float2(1.0));
  float2 relCenter = clamp(p * invSize, float2(-1.0), float2(1.0));
  float2 isoRel = clamp(p / minHalf, float2(-2.2), float2(2.2));

  // Crisp readable core with vivid passive & pressed perimeter Snell lens refraction.
  float2 uv = fragCoord + ray.xy * (0.64 * rayDepth * refract_intensity)
      * (0.86 + lift * 0.34);
  uv -= isoRel * (0.028 + lift * 0.042) * t * (0.28 + 0.72 * domeT) * (1.0 - 0.32 * bevel);

  float2 uvMin = center - size + 0.5;
  float2 uvMax = center + size - 0.5;
  uv = clamp(uv, uvMin, uvMax);

  // Symmetric RGB chromatic dispersion across curved edges + inset opposite-side reflection.
  float2 disp = ray.xy * uDp * (0.85 + lift * 1.15) * bevel * insetFade;
  half4 backdrop = img.eval(uv);
  half rChan = img.eval(clamp(uv + disp, uvMin, uvMax)).r;
  half bChan = img.eval(clamp(uv - disp, uvMin, uvMax)).b;
  half lumaPre = dot(backdrop.rgb, half3(0.2126, 0.7152, 0.0722));
  float dispGuard = mix(0.20, 1.0, smoothstep(0.16, 0.42, float(lumaPre)));
  float dispMix = clamp((0.36 + 0.24 * lift) * bevel * insetFade * dispGuard, 0.0, 0.65);
  backdrop.r = mix(backdrop.r, rChan, half(dispMix));
  backdrop.b = mix(backdrop.b, bChan, half(dispMix));

  float oppDepthPx = (1.9 + clamp(dDp - 1.4, 0.0, 3.0) * 2.1) * uDp;
  float hReflWeight = gaussian((dDp - 2.45) / 0.92)
      * pow(abs(edgeDir.x), 1.55)
      * smoothstep(0.58, 0.90, abs(relCenter.x))
      * insetFade;
  float2 mirrorSideUV = clamp(
      center + float2(-sign(p.x) * max(0.0, size.x - oppDepthPx), p.y * 0.78),
      uvMin, uvMax);
  half4 sideMirror = img.eval(mirrorSideUV);
  backdrop.rgb = mix(backdrop.rgb, sideMirror.rgb, half(hReflWeight * (0.21 + 0.16 * lift)));

  float vReflWeight = gaussian((dDp - 2.35) / 0.95)
      * pow(abs(edgeDir.y), 1.70)
      * (1.0 - abs(relCenter.x) * 0.22)
      * insetFade;
  float2 mirrorVertUV = clamp(
      center + float2(p.x * 0.94, -sign(p.y) * max(0.0, size.y - oppDepthPx)),
      uvMin, uvMax);
  half4 vertMirror = img.eval(mirrorVertUV);
  backdrop.rgb = mix(backdrop.rgb, vertMirror.rgb, half(vReflWeight * (0.18 + 0.14 * lift)));

  // Source backdrop carries pre-applied 3x saturation; restore natural chromatic balance on dark slate cards
  // so Dark Blue surfaces stay slate rather than glowing cobalt, while bright colored content remains crisp.
  half luma = dot(backdrop.rgb, half3(0.2126, 0.7152, 0.0722));
  float bgLumaF = float(luma);
  float fgAlpha = clamp(float(foreground_color_premultiplied.a), 0.001, 1.0);
  float fgLumaF = float(dot(foreground_color_premultiplied.rgb / half(fgAlpha), half3(0.2126, 0.7152, 0.0722)));
  float darkCrystalTint = 1.0 - smoothstep(0.38, 0.65, fgLumaF);
  float deSatScale = mix(0.50, mix(0.35, 0.54, smoothstep(0.22, 0.48, bgLumaF)), darkCrystalTint);
  backdrop.rgb = clamp(mix(half3(luma), backdrop.rgb, half(deSatScale)), half3(0.0), half3(1.0));
  // In light theme let bright backdrop colors breathe; in dark theme keep full clarity with a gentle
  // contrast veil only if very bright pixels pass behind white header labels.
  float lightBgAdaptive = mix(1.0, 0.72, smoothstep(0.18, 0.70, bgLumaF) * (1.0 - darkCrystalTint));
  half4 fgTint = half4(foreground_color_premultiplied) * half((1.0 - lift * 0.38) * lightBgAdaptive);
  half4 surface = srcOver(fgTint, backdrop);
  if (glass_adaptive > 0.5) {
    float contrastVeil = smoothstep(0.56, 0.96, bgLumaF) * darkCrystalTint * 0.16 * (1.0 - lift * 0.35);
    surface.rgb *= half(1.0 - contrastVeil);
  }

  // Soft TIR meniscus depth gradient inside the bevel (adaptive in light themes, zero hard outline).
  float lightWallBoost = mix(1.0, 1.85, smoothstep(0.55, 0.92, bgLumaF));
  float outerWall = gaussian((dDp - 2.10) / 1.25);
  float meniscus = gaussian((dDp - 3.85) / 1.75);
  surface.rgb *= half(1.0 - lightWallBoost * ((0.036 + 0.028 * lift) * outerWall + (0.018 + 0.018 * lift) * meniscus));

  // Diagonal top-left -> bottom-right Fresnel catchlights + delicate corner sheen (no full perimeter white ring).
  float angle = -2.356 + move * 0.42 + (glass_light_angle - 5.4978);
  float2 lightDir = float2(cos(angle), sin(angle));
  float rawDot = dot(edgeDir, lightDir);
  float2 perpDir = float2(-lightDir.y, lightDir.x);
  float perpDot = dot(edgeDir, perpDir);

  // Keep diagonal corner glints balanced between circular buttons and wide pills without lighting
  // horizontal straight edges or wrapping dark surfaces in an artificial 360deg white wireframe.
  float pillWeight = smoothstep(0.18, 0.95, max(0.0, (size.x - size.y) / max(size.y, 1.0)));
  float keyPow = mix(3.2, 2.9, pillWeight);
  float catchPow = mix(3.2, 2.9, pillWeight);
  float keyArc = pow(max(rawDot, 0.0), keyPow) * 0.82;
  float catchArc = pow(max(-rawDot, 0.0), catchPow) * 0.64;
  float offDiagTopRight = pow(max(perpDot, 0.0), 4.4) * (0.34 * pillWeight);
  float offDiagBotLeft = pow(max(-perpDot, 0.0), 4.4) * (0.24 * pillWeight);
  float capBoost = pow(abs(edgeDir.x), 3.4) * (0.12 + 0.16 * lift) * (1.0 - 0.35 * pillWeight);
  float rimCore = gaussian((dDp - 1.50) / 1.40);
  float innerRidge = gaussian((dDp - 3.35) / 2.20);
  float darkGlintScale = mix(0.92, 0.74, darkCrystalTint);
  float rimSpec = (keyArc + catchArc + offDiagTopRight + offDiagBotLeft + capBoost)
      * (rimCore * 0.70 + innerRidge * 0.30) * (0.34 + 0.32 * lift) * darkGlintScale;

  float highlightStrength = clamp(glass_highlight, 0.06, 1.35);
  if (glass_adaptive > 0.5) {
    highlightStrength *= clamp(1.18 - bgLumaF * 0.26, 0.82, 1.18);
  }

  float totalGlint = highlightStrength * rimSpec;
  half3 specTint = mix(half3(0.92, 0.96, 1.0), half3(1.0, 0.99, 0.97), half(clamp(rawDot * 0.5 + 0.5, 0.0, 1.0)));
  surface.rgb = min(half3(1.0), surface.rgb + specTint * half(totalGlint * float(surface.a)));

  return surface;
}
