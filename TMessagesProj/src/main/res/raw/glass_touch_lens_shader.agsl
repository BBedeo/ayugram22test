// Glass Touch lens under the finger, after the exteraGram plugin "Glass Touch" (@vibecodersnotes, Claude).
uniform shader img;
uniform float2 size;
uniform float2 center;
uniform float radius;
uniform float rim;
uniform float p;

half4 main(float2 xy) {
    if (xy.x < 0.0 || xy.y < 0.0 || xy.x > size.x || xy.y > size.y) {
        return img.eval(xy);
    }
    // sampling stays half a pixel inside the view
    float2 lo = float2(0.5, 0.5);
    float2 hi = size - float2(0.5, 0.5);
    float2 d = xy - center;
    float dist = length(d);
    if (dist >= radius) {
        return img.eval(xy);
    }
    float t = clamp(1.0 - dist / radius, 0.0, 1.0);
    float f = t * t * (3.0 - 2.0 * t);
    float2 n = d / (dist + 0.001);
    float m = clamp(0.38 * p, -0.25, 0.5);
    float2 uv = xy - d * f * m;
    float2 ca = n * f * 3.0 * p;
    half4 g = img.eval(clamp(uv, lo, hi));
    half4 r = img.eval(clamp(uv + ca, lo, hi));
    half4 b = img.eval(clamp(uv - ca, lo, hi));
    half4 col = half4(r.r, g.g, b.b, g.a);
    float ring = smoothstep(0.0, 0.3, t) * (1.0 - smoothstep(0.3, 0.75, t));
    float h = (ring * 0.10 * rim + f * 0.04) * min(abs(p), 1.2);
    col.rgb += half3(h, h, h) * col.a;
    return col;
}
