uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float glass_press;
uniform float glass_highlight;
uniform float glass_light_angle;
uniform float glass_motion;
uniform float glass_adaptive;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
  half3 outRGB = src.rgb + dst.rgb * (1.0 - src.a);
  float outA = src.a + (1.0 - src.a) * dst.a;
  return half4(outRGB, outA);
}

float gaussian(float x) {
  return exp(-x * x);
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = float(sdfRect(half2(p), half4(radius)));
  float sd = min(sdRaw, 0.0);

  float2 gradRaw = float2(
      float(sdfRect(half2(p + float2(1.0, 0.0)), half4(radius))) - sdRaw,
      float(sdfRect(half2(p + float2(0.0, 1.0)), half4(radius))) - sdRaw);
  float gradLen = length(gradRaw);
  float2 edgeDir = gradLen > 0.001 ? gradRaw / gradLen : float2(0.0, -1.0);

  float t = clamp(thickness, 2.0, min(size.x, size.y) * 0.92);
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 1.15), 0.0, 1.0);

  // Full curved 3D lens profile (shoulder bevel + interior radial dome).
  float rimT = clamp(1.0 + sd / t, 0.0, 1.0);
  float bevel = pow(max(rimT, 0.0001), 1.18);
  float domeT = clamp(-sd / max(min(size.x, size.y) * 0.95, 1.0), 0.0, 1.0);

  float nCos = bevel * 0.95;
  float nSin = sqrt(max(0.02, 1.0 - nCos * nCos));
  float3 normal = normalize(float3(edgeDir * nCos, nSin));
  float3 ray = refract(float3(0.0, 0.0, -1.0), normal, 1.0 / max(refract_index, 1.05));

  float h = sd < -t ? t : sqrt(max(0.0, -sd * (2.0 * t + sd)));
  float rayDepth = (h + 9.0 * t) / max(-ray.z, 0.25);

  float2 invSize = 1.0 / max(size, float2(1.0));
  float2 relCenter = clamp(p * invSize, float2(-1.0), float2(1.0));
  float2 isoRel = clamp(p / max(min(size.x, size.y), 1.0), float2(-2.2), float2(2.2));

  // Strong optical rim refraction + spherical dome magnification across scrolled content.
  float2 uv = fragCoord + ray.xy * (0.82 * rayDepth * refract_intensity)
      * (1.0 + lift * 0.48);
  uv += float2(move * 7.8, 0.0) * bevel
      - isoRel * (0.115 + lift * 0.165) * t * (0.35 + 0.65 * domeT);

  float2 uvMin = center - size + 0.5;
  float2 uvMax = center + size - 0.5;
  uv = clamp(uv, uvMin, uvMax);

  // Prismatic RGB dispersion around the curved glass bevel.
  float2 disp = ray.xy * t * (0.58 + lift * 0.34) * bevel;
  half4 backdrop = img.eval(uv);
  half rChan = img.eval(clamp(uv + disp, uvMin, uvMax)).r;
  half bChan = img.eval(clamp(uv - disp, uvMin, uvMax)).b;
  backdrop.r = mix(backdrop.r, rChan, half((0.68 + 0.26 * lift) * bevel));
  backdrop.b = mix(backdrop.b, bChan, half((0.68 + 0.26 * lift) * bevel));

  // Crisp optical color vibrancy & micro-contrast inside the crystal lens.
  half luma = dot(backdrop.rgb, half3(0.2126, 0.7152, 0.0722));
  backdrop.rgb = clamp(mix(half3(luma), backdrop.rgb, half(1.20 + 0.16 * lift)), half3(0.0), half3(1.0));

  // bgLuma-adaptive _UILiquidLensView body wash: keeps a luminous cool crystal dome
  // on dark backgrounds while clearing into transparent glass during hold/drag.
  float bgLumaF = float(luma);
  float darkAdaptive = mix(1.0, 0.48, smoothstep(0.08, 0.42, bgLumaF));
  half4 fgTint = half4(foreground_color_premultiplied) * half((1.0 - lift * 0.45) * darkAdaptive);
  half4 surface = srcOver(fgTint, backdrop);

  // Cool sapphire crystal dome volume so dark screens have genuine glass depth instead of flat void.
  half3 crystalWash = half3(0.14, 0.20, 0.29) * half((1.0 - smoothstep(0.05, 0.34, bgLumaF)) * (0.32 + 0.18 * domeT));
  surface.rgb = min(half3(1.0), surface.rgb + crystalWash * half(surface.a));

  // Crisp inner TIR shadow groove inside the bright rim (gives unmistakable 3D bevel contrast).
  float outerWall = gaussian((-sd - t * 0.24) / max(2.2, t * 0.12));
  float meniscus = gaussian((-sd - t * 0.36) / max(2.6, t * 0.18));
  surface.rgb *= half(1.0 - (0.18 + 0.10 * lift) * outerWall - (0.10 + 0.08 * lift) * meniscus);

  // Diagonal iOS Fresnel corner arcs + lateral end-cap glints framing words & icons.
  float angle = glass_light_angle + move * 0.44;
  float2 lightDir = float2(cos(angle), sin(angle));
  float rawDot = dot(edgeDir, lightDir);
  float keyArc = pow(max(rawDot * 0.65 + 0.35, 0.0001), 3.1) * 1.05;
  float catchArc = pow(max(-rawDot * 0.65 + 0.35, 0.0001), 3.5) * 0.72;
  float capBoost = pow(max(abs(edgeDir.x) * 0.78 + 0.22, 0.0001), 1.35) * 0.42;
  float fresnelSide = 0.09 + 0.11 * lift;

  float rimCore = gaussian((-sd - max(1.2, t * 0.055)) / max(1.4, t * 0.068));
  float rimSoft = gaussian((-sd - t * 0.16) / max(2.8, t * 0.19));
  float rimSpec = (keyArc + catchArc + capBoost + fresnelSide)
      * (rimCore * 0.78 + rimSoft * 0.30) * (0.72 + 0.38 * lift);

  // Upper glass dome sheen + focused bottom lens bounce caustic + drag motion glare.
  float upperCrown = smoothstep(0.24, -0.90, relCenter.y) * (0.45 + 0.55 * (1.0 - bevel)) * (0.068 + 0.028 * (1.0 - lift));
  float lowerCaustic = smoothstep(-0.08, 0.92, relCenter.y) * bevel * (0.085 + 0.18 * lift);
  float sweepCoord = relCenter.x * 0.78 + relCenter.y * 0.45 - move * 0.38;
  float sweep = gaussian(sweepCoord / 0.25) * (0.03 + 0.24 * abs(move) + 0.12 * press) * (0.35 + 0.65 * bevel);

  float highlightStrength = clamp(glass_highlight, 0.72, 1.0);
  if (glass_adaptive > 0.5) {
    highlightStrength *= clamp(1.30 - bgLumaF * 0.34, 0.84, 1.30);
  }

  float totalGlint = highlightStrength * (rimSpec + upperCrown + lowerCaustic + sweep);
  half3 specTint = mix(half3(0.84, 0.94, 1.0), half3(1.0, 0.99, 0.96), half(clamp(rawDot * 0.5 + 0.5, 0.0, 1.0)));
  surface.rgb = min(half3(1.0), surface.rgb + specTint * half(totalGlint * float(surface.a)));

  return surface;
}
