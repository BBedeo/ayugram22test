uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float glass_press;
uniform float glass_highlight;
uniform float glass_light_angle;
uniform float glass_motion;
uniform float glass_adaptive;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
  half3 outRGB = src.rgb + dst.rgb * (1.0 - src.a);
  float outA = src.a + (1.0 - src.a) * dst.a;
  return half4(outRGB, outA);
}

float gaussian(float x) {
  return exp(-x * x);
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sdRaw = float(sdfRect(half2(p), half4(radius)));
  float sd = min(sdRaw, 0.0);

  float2 gradRaw = float2(
      float(sdfRect(half2(p + float2(1.0, 0.0)), half4(radius))) - sdRaw,
      float(sdfRect(half2(p + float2(0.0, 1.0)), half4(radius))) - sdRaw);
  float gradLen = length(gradRaw);
  float2 edgeDir = gradLen > 0.001 ? gradRaw / gradLen : float2(0.0, -1.0);

  float t = clamp(thickness, 2.0, min(size.x, size.y) * 0.92);
  float press = clamp(glass_press, 0.0, 1.0);
  float move = clamp(glass_motion, -1.0, 1.0);
  float lift = clamp(max(press, abs(move) * 1.15), 0.0, 1.0);

  // Smooth convex glass bevel rising from interior plateau (0) to curved outer wall (1).
  float rimT = clamp(1.0 + sd / t, 0.0, 1.0);
  float bevel = pow(max(rimT, 0.0001), 1.35);

  float nCos = bevel * 0.92;
  float nSin = sqrt(max(0.02, 1.0 - nCos * nCos));
  float3 normal = normalize(float3(edgeDir * nCos, nSin));
  float3 ray = refract(float3(0.0, 0.0, -1.0), normal, 1.0 / max(refract_index, 1.05));

  float h = sd < -t ? t : sqrt(max(0.0, -sd * (2.0 * t + sd)));
  float rayDepth = (h + 7.5 * t) / max(-ray.z, 0.25);

  float2 invSize = 1.0 / max(size, float2(1.0));
  float2 relCenter = clamp(p * invSize, float2(-1.0), float2(1.0));
  float2 isoRel = clamp(p / max(min(size.x, size.y), 1.0), float2(-2.2), float2(2.2));

  // Strong optical rim refraction + isotropic convex dome magnification in the center.
  float2 uv = fragCoord + ray.xy * (0.42 * rayDepth * refract_intensity)
      * (1.0 + lift * 0.35);
  uv += float2(move * 5.8, 0.0) * bevel
      - isoRel * (0.085 + lift * 0.105) * t * (1.0 - bevel * 0.30);

  float2 uvMin = center - size + 0.5;
  float2 uvMax = center + size - 0.5;
  uv = clamp(uv, uvMin, uvMax);

  // Prismatic RGB dispersion concentrated around the curved lens bevel.
  float2 disp = ray.xy * t * (0.34 + lift * 0.24) * bevel;
  half4 backdrop = img.eval(uv);
  half rChan = img.eval(clamp(uv + disp, uvMin, uvMax)).r;
  half bChan = img.eval(clamp(uv - disp, uvMin, uvMax)).b;
  backdrop.r = mix(backdrop.r, rChan, half(0.80 * bevel));
  backdrop.b = mix(backdrop.b, bChan, half(0.80 * bevel));

  // Boost chromatic vibrancy & micro-contrast so UI content gleams inside the lens.
  half luma = dot(backdrop.rgb, half3(0.2126, 0.7152, 0.0722));
  backdrop.rgb = clamp(mix(half3(luma), backdrop.rgb, half(1.14 + 0.12 * lift)), half3(0.0), half3(1.0));

  // Two-state _UILiquidLensView tint: sleek sapphire crystal at rest, clearing smoothly on lift.
  half4 fgTint = half4(foreground_color_premultiplied) * half(1.0 - lift * 0.68);
  half4 surface = srcOver(fgTint, backdrop);

  // Delicate TIR depth separation + 3D internal meniscus band.
  float outerWall = gaussian((-sd - 0.75) / max(1.0, t * 0.055));
  float meniscus = gaussian((-sd - t * 0.26) / max(2.0, t * 0.15));
  surface.rgb *= half(1.0 - (0.055 + 0.045 * lift) * outerWall - (0.050 + 0.055 * lift) * meniscus);

  // Silky diagonal Fresnel corner glints (never a chalky uniform 360 border).
  float angle = glass_light_angle + move * 0.42;
  float2 lightDir = float2(cos(angle), sin(angle));
  float rawDot = dot(edgeDir, lightDir);
  float keyArc = pow(max(rawDot * 0.65 + 0.35, 0.0001), 3.6) * 0.66;
  float catchArc = pow(max(-rawDot * 0.65 + 0.35, 0.0001), 4.0) * 0.40;
  float fresnelSide = 0.015 + 0.045 * lift;

  float rimCore = gaussian((-sd - max(1.0, t * 0.058)) / max(0.95, t * 0.055));
  float rimSoft = gaussian((-sd - t * 0.16) / max(2.2, t * 0.16));
  float rimSpec = (keyArc + catchArc + fresnelSide) * (rimCore * 0.56 + rimSoft * 0.18) * (0.58 + 0.42 * lift);

  // Subtle top-dome crystal sheen + focused lower caustic + motion sweep.
  float upperCrown = smoothstep(0.18, -0.82, relCenter.y) * (1.0 - bevel * 0.40) * (0.032 - 0.012 * lift);
  float lowerCaustic = smoothstep(-0.05, 0.85, relCenter.y) * bevel * (0.025 + 0.105 * lift);
  float sweepCoord = relCenter.x * 0.80 + relCenter.y * 0.45 - move * 0.38;
  float sweep = gaussian(sweepCoord / 0.28) * (0.02 + 0.16 * abs(move) + 0.08 * press) * (0.30 + 0.70 * bevel);

  float highlightStrength = clamp(glass_highlight, 0.55, 1.0);
  if (glass_adaptive > 0.5) {
    float bgLuma = float(dot(backdrop.rgb, half3(0.2126, 0.7152, 0.0722)));
    highlightStrength *= clamp(1.22 - bgLuma * 0.42, 0.76, 1.22);
  }

  float totalGlint = highlightStrength * (rimSpec + upperCrown + lowerCaustic + sweep);
  half3 specTint = mix(half3(0.84, 0.93, 1.0), half3(1.0, 0.99, 0.96), half(clamp(rawDot * 0.5 + 0.5, 0.0, 1.0)));
  surface.rgb = min(half3(1.0), surface.rgb + specTint * half(totalGlint * float(surface.a)));

  return surface;
}
